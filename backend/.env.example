# Cloud PostgreSQL with pgvector (Neon or Supabase)
# Neon example:
# DATABASE_URL="postgresql://neondb_owner:<password>@ep-<host>.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Supabase example:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Authentication (generate with: openssl rand -hex 32)
JWT_SECRET_KEY="replace-with-a-strong-random-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (JSON array or comma-separated URLs)
CORS_ORIGINS='["http://localhost:3000"]'

# Google Gemini API (Google AI Studio - Phase 2 & 3)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS=768
